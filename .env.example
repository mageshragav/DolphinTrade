# DolphinTrade environment (copy to .env and edit)
# All variables are optional; defaults keep the system in DRY-RUN.

# --- trading safety ---
DT_DRY_RUN=true
DT_THETA=0.65
DT_COMBOS=5m:15m,5m:30m,5m:1h,15m:1h,30m:1h
DT_HOURS_WINDOW=all
DT_PAIRS=EURUSD,EURJPY,GBPUSD,USDCAD,USDJPY,EURAUD,EURCAD,EURGBP
DT_EQUITY=1000

# --- LLM (headline sentiment) ---
DT_GEMINI_API_KEY=

# --- telegram (falls back to the values in common/constants.py) ---
DT_TELEGRAM_BOT_TOKEN=
DT_TELEGRAM_GROUP_ID=

# --- database (docker compose provides postgres automatically) ---
# DT_DATABASE_URL=postgresql+asyncpg://dolphin:dolphin@localhost:5432/dolphintrade
